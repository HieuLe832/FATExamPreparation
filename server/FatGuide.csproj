<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FatGuide</RootNamespace>
    <ClientDir>$(MSBuildProjectDirectory)/../client</ClientDir>
  </PropertyGroup>

  <!-- Build the React client into wwwroot when it has not been built yet. The Docker build sets
       SkipClientBuild=true because the backend image does not build the frontend. -->
  <Target Name="BuildClient" BeforeTargets="Build" Condition="!Exists('wwwroot/index.html') And '$(SkipClientBuild)' != 'true'">
    <Exec Command="npm install" WorkingDirectory="$(ClientDir)" Condition="!Exists('$(ClientDir)/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(ClientDir)" />
  </Target>

</Project>
