# Copy to client/.env.local for local overrides (.env.local is gitignored). Nothing here is secret.

# Origin of the API the browser calls. Leave empty locally: the Vite dev server proxies /api.
# On Vercel set it in Project Settings → Environment Variables (it is baked in at build time), e.g.
# VITE_API_BASE_URL=https://fat-guide-api.azurewebsites.net
VITE_API_BASE_URL=

# Dev server only: where Vite proxies /api. dotnet run listens on 5080; the Docker image on 8080.
API_PROXY_TARGET=http://localhost:5080
